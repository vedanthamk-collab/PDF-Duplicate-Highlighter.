{
  "manifest_version": 3,
  "name": "PDF Duplicate Highlighter",
  "version": "0.3.0",
  "description": "Find and mark duplicate PDF pages locally, preserving the first occurrence.",
  "permissions": [
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}