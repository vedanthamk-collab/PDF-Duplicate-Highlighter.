{
  "manifest_version": 3,
  "name": "PDF Duplicate Highlighter",
  "version": "0.4.0",
  "description": "Find duplicate PDF pages locally and download a clean copy, preserving the earliest original.",
  "permissions": [
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "file:///*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
