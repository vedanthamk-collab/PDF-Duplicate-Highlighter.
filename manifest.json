{
  "manifest_version": 3,
  "name": "PDF Duplicate Highlighter",
  "version": "0.6.1",
  "description": "Merge PDFs and images, find duplicate pages, and review bill expenses locally.",
  "permissions": [
    "activeTab",
    "tabs",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "file:///*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
